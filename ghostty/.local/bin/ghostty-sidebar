#!/bin/bash
# Bail if sidebar already running
pgrep -f "ghostty --config-file=$HOME/.config/ghostty/sidebar.conf" > /dev/null && exit 0

# Wait for desktop session to be fully ready
sleep 4

# Ubuntu 26.04's Mutter gates XTestFakeInput (xdotool key/type) behind the
# RemoteDesktop portal consent dialog, which nothing here answers, so synthetic
# keystrokes silently drop. ydotool injects via /dev/uinput (kernel level),
# bypassing that gate entirely. windowmove/resize/focus are plain WM protocol
# requests, not synthetic input, so xdotool still works fine for those.
export YDOTOOL_SOCKET="/run/user/$(id -u)/.ydotool_socket"

# Force XWayland so xdotool can manage this window. GTK_IM_MODULE=none
# disables IBus for this process -- IBus is known to silently eat the first
# real keystroke after a window/pane gains focus, which is what made the
# bottom split's shell look like it wasn't accepting input. Not needed for
# a plain terminal (no IME input required).
GDK_BACKEND=x11 GTK_IM_MODULE=none ghostty --config-file="$HOME/.config/ghostty/sidebar.conf" &
GHOSTTY_PID=$!

# Wait up to 10s for the window to appear (poll by PID)
WID=""
for i in $(seq 1 20); do
    WID=$(xdotool search --pid "$GHOSTTY_PID" 2>/dev/null | tail -1)
    [ -n "$WID" ] && break
    sleep 0.5
done

if [ -z "$WID" ]; then
    logger -t ghostty-sidebar "ERROR: window not found for PID $GHOSTTY_PID"
    exit 1
fi

# Use the desktop's usable workarea (excludes top bar + dock), not raw screen
# size, so the window actually spans top-of-screen to top-of-dock instead of
# a fixed height from the ghostty config.
read -r WORK_X WORK_Y WORK_W WORK_H <<< "$(xprop -root _NET_WORKAREA 2>/dev/null | sed 's/.*= //' | cut -d, -f1-4 | tr ',' ' ')"
WORK_X=${WORK_X:-0}
WORK_Y=${WORK_Y:-0}
WORK_W=${WORK_W:-1920}
WORK_H=${WORK_H:-1200}

# Keep the configured window width, but stretch height to fill the workarea
WIN_W=$(xdotool getwindowgeometry "$WID" 2>/dev/null | awk '/Geometry/{split($2,a,"x"); print a[1]}')
WIN_W=${WIN_W:-380}
WIN_H=$WORK_H
WIN_X=$((WORK_X + WORK_W - WIN_W))
WIN_Y=$WORK_Y

# Ghostty re-applies its own config size (window-height=51) asynchronously
# after the window ID already exists, racing our resize below and winning
# if we resize too early. Let it finish settling first.
sleep 0.5
xdotool windowmove "$WID" "$WIN_X" "$WIN_Y"
xdotool windowsize "$WID" "$WIN_W" "$WIN_H"

# Focus, type btop, run it (ydotool, not xdotool -- see note above)
xdotool windowfocus --sync "$WID"
sleep 0.3
ydotool type "btop"
ydotool key 28:1 28:0   # Return

# Wait for btop to initialize, then split (Ctrl+Shift+E = new split down)
sleep 1.5
xdotool windowfocus --sync "$WID"
ydotool key 29:1 42:1 18:1 18:0 42:0 29:0   # ctrl+shift+e

# new_split:down should auto-focus the new pane, but don't rely on a synthetic
# keybind's side effect alone -- explicitly goto_split:down (ctrl+alt+Down)
# so the bottom shell definitely has keyboard focus, not the btop pane above it.
sleep 0.3
ydotool key 29:1 56:1 108:1 108:0 56:0 29:0   # ctrl+alt+down

# Re-stomp size/position: ghostty's own resize-on-realize and the new split
# can both perturb geometry after our first resize; reassert once more so
# top-of-screen-to-top-of-dock actually holds after everything settles.
sleep 0.5
xdotool windowmove "$WID" "$WIN_X" "$WIN_Y"
xdotool windowsize "$WID" "$WIN_W" "$WIN_H"
