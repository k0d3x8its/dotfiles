#!/bin/bash
# Wait for desktop session to be fully ready
sleep 4

# Force XWayland so xdotool can manage this window
GDK_BACKEND=x11 ghostty --config-file="$HOME/.config/ghostty/sidebar.conf" &
GHOSTTY_PID=$!

# Wait up to 10s for the window to appear (poll by PID)
WID=""
for i in $(seq 1 20); do
    WID=$(xdotool search --pid "$GHOSTTY_PID" 2>/dev/null | tail -1)
    [ -n "$WID" ] && break
    sleep 0.5
done

if [ -z "$WID" ]; then
    logger -t ghostty-sidebar "ERROR: window not found for PID $GHOSTTY_PID"
    exit 1
fi

# Detect screen dimensions dynamically
SCREEN_W=$(xrandr --current 2>/dev/null | awk '/\*/{print $1}' | head -1 | cut -dx -f1)
SCREEN_H=$(xrandr --current 2>/dev/null | awk '/\*/{print $1}' | head -1 | cut -dx -f2)
SCREEN_W=${SCREEN_W:-1920}
SCREEN_H=${SCREEN_H:-1200}

# Get actual rendered window width, position at right edge
WIN_W=$(xdotool getwindowgeometry "$WID" 2>/dev/null | awk '/Geometry/{split($2,a,"x"); print a[1]}')
WIN_W=${WIN_W:-380}
WIN_X=$((SCREEN_W - WIN_W))

xdotool windowmove "$WID" "$WIN_X" 0
xdotool windowsize "$WID" "$WIN_W" "$SCREEN_H"

# Focus, type btop, run it
xdotool windowfocus --sync "$WID"
sleep 0.3
xdotool type --clearmodifiers "btop"
xdotool key Return

# Wait for btop to initialize, then split (Ctrl+Shift+E = new split down)
sleep 1.5
xdotool windowfocus --sync "$WID"
xdotool key ctrl+shift+e
