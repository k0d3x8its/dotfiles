#!/usr/bin/env python3
"""
update-triage: reads ~/dev/.triage-cache, writes ~/dev/TRIAGE-BLOCK.md
Zero Claude tokens. Called by /handoff step 7d; also run manually.
"""

import json
import re
import sys
from datetime import datetime
from pathlib import Path

CACHE = Path.home() / "dev" / ".triage-cache"
OUTPUT = Path.home() / "dev" / "TRIAGE-BLOCK.md"
DEV = Path.home() / "dev"
DATES_FILE = DEV / ".triage-dates"

STALE_DAYS = 7
STALE_LABEL = "stale since"
STALE_COLOR = "#ff6600"

TIER_COLORS = {
    "CRITICAL": "#ff1a1a",
    "HIGH":     "#cc0000",
    "MEDIUM":   "#e05000",
    "LOW":      "#ffd700",
    "BACKLOG":  "#4d94ff",
}

TIER_LABELS = {
    "CRITICAL": "🔴 CRITICAL",
    "HIGH":     "🟥 HIGH",
    "MEDIUM":   "🔶 MEDIUM",
    "LOW":      "🟡 LOW",
    "BACKLOG":  "🔵 BACKLOG",
}

ANNOTATION_COLORS = {
    "BUG":         "#ff6b6b",
    "FEAT":        "#51cf66",
    "CHORE":       "#868e96",
    "TEST":        "#74c0fc",
    "RELEASE":     "#da77f2",
    "DECISION":    "#ffa94d",
    "INVESTIGATE": "#a855f7",
    "SYNC":        "#a9e34b",
    "WAITING":     "#fcc419",
    "SECURITY":    "#2563eb",
    "DOCS":        "#63e6be",
    "PERFORMANCE": "#fd7e14",
    "UX":          "#f783ac",
}

PRIORITY_MAP = {
    "BROKEN":  "CRITICAL",
    "BLOCKER": "HIGH",
    "LOW":     "LOW",
    "BACKLOG": "BACKLOG",
}

SINCE_STRIP_RE = re.compile(r"\[since:[^\]]*\]\s*", re.IGNORECASE)

URGENT_KEYWORDS = [
    "failing", "broken", "not yet", "do not", "warning", "stale", "never",
    "never committed", "bug", "unresolved", "critical", "missing",
    "haven't", "has not", "hasn't", "error",
]


def extract_since(raw: str) -> str | None:
    """Return YYYY-MM-DD from [since: DATE] tag, or None. Ignores malformed dates."""
    m = re.search(r"\[since:\s*(\d{4}-\d{2}-\d{2})\]", raw, re.IGNORECASE)
    if not m:
        return None
    try:
        datetime.fromisoformat(m.group(1))
        return m.group(1)
    except ValueError:
        return None


def parse_tags(line: str) -> list:
    # Only scan the tag prefix — body text like "[TEST] tag" would poison tier assignment
    m = re.match(r"^- \[ \] ((?:\[[A-Z][A-Z0-9_-]*\])*)", line)
    return re.findall(r"\[([A-Z][A-Z0-9_-]*)\]", m.group(1)) if m else []


def is_urgent(line: str) -> bool:
    # strip backtick spans before keyword scan to avoid matching code descriptions
    stripped = re.sub(r"`[^`]*`", "", line).lower()
    return any(kw in stripped for kw in URGENT_KEYWORDS)


def get_tier(tags: list, line: str) -> str:
    if "TEST" in tags:
        return "CRITICAL"
    for tag in tags:
        if tag in PRIORITY_MAP:
            return PRIORITY_MAP[tag]
    return "HIGH" if is_urgent(line) else "MEDIUM"


def colorize_tags(text: str) -> str:
    def replace(m):
        tag = m.group(1)
        color = ANNOTATION_COLORS.get(tag)
        return f'<span style="color:{color};">[{tag}]</span>' if color else m.group(0)
    # only colorize tags outside backtick spans
    parts = re.split(r"(`[^`]*`)", text)
    return "".join(
        part if i % 2 == 1 else re.sub(r"\[([A-Z][A-Z0-9_-]*)\]", replace, part)
        for i, part in enumerate(parts)
    )


def strip_priority_tags(text: str) -> str:
    return re.sub(r"\s+", " ", re.sub(r"\[(BROKEN|BLOCKER|LOW|BACKLOG)\]", "", text)).strip()


def item_key(raw: str) -> str:
    """Stable lookup key: strip '- [ ] ' prefix + priority tags + [since:] + normalize whitespace."""
    text = re.sub(r"\[(BROKEN|BLOCKER|LOW|BACKLOG)\]", "", raw[6:])
    text = SINCE_STRIP_RE.sub("", text)
    return re.sub(r"\s+", " ", text).strip()


def update_item_dates(projects: dict) -> dict:
    """Register new items; [since:] tag always wins over cached date; prune gone items; return dates dict."""
    dates = json.loads(DATES_FILE.read_text()) if DATES_FILE.exists() else {}
    today = datetime.now().strftime("%Y-%m-%d")
    current = {item_key(line): (extract_since(line) or mtime_str or today)
               for todos in projects.values() for line, mtime_str in todos}
    for k, default in current.items():
        dates.setdefault(k, default)
    # [since:] always overrides — enables retroactive date correction
    for todos in projects.values():
        for line, _ in todos:
            since = extract_since(line)
            if since:
                dates[item_key(line)] = since
    dates = {k: v for k, v in dates.items() if k in current}
    DATES_FILE.write_text(json.dumps(dates, indent=2))
    return dates


def parse_cache(path: Path) -> dict:
    projects = {}
    current = None
    for line in path.read_text().splitlines():
        if line.startswith("## "):
            current = line[3:].strip()
            projects[current] = []
        elif current and line.startswith("path: "):
            todos_path = Path(line[6:].strip()).expanduser()
            if todos_path.exists():
                mtime_str = datetime.fromtimestamp(todos_path.stat().st_mtime).strftime("%Y-%m-%d")
                projects[current] += [
                    (tline, mtime_str) for tline in todos_path.read_text().splitlines()
                    if tline.startswith("- [ ]")
                ]
        elif current and line.startswith("- [ ]"):
            # legacy content format: backward compat for unmigrated projects
            projects[current].append((line, None))
    return projects


def release_pending(projects: dict) -> list:
    return sorted(
        p for p in projects
        if p != "[machine]"
        and (rn := DEV / p / "RELEASE-NOTES.md").exists()
        and rn.stat().st_size > 0
    )


def find_orphans(projects: dict) -> list:
    tracked = {p.strip("[]") for p in projects}
    log_files = ("SESSION-LOG.md", "session-log.md", "TODOS.md")
    return [
        d.name for d in sorted(DEV.iterdir())
        if d.is_dir() and not d.name.startswith(".")
        and not any((d / f).exists() for f in log_files)
        and d.name not in tracked
    ]


def build_triage(projects: dict, item_dates: dict) -> dict:
    tiers = {t: [] for t in TIER_COLORS}
    for proj, todos in projects.items():
        for line, _ in todos:
            tags = parse_tags(line)
            date_str = item_dates.get(item_key(line))
            first_seen = datetime.fromisoformat(date_str) if date_str else None
            tiers[get_tier(tags, line)].append((proj, line, is_urgent(line), first_seen))
    for tier in tiers:
        tiers[tier].sort(key=lambda x: (0 if x[2] else 1, x[0]))
    return tiers


def fmt_line(project: str, raw: str, urgent: bool, first_seen) -> str:
    text = colorize_tags(strip_priority_tags(SINCE_STRIP_RE.sub("", raw[6:].strip())))
    if first_seen and (datetime.now() - first_seen).days > STALE_DAYS:
        text += f' <span style="color:{STALE_COLOR};font-weight:bold;">[{STALE_LABEL} {first_seen:%Y-%m-%d}]</span>'
    proj = project if project.startswith("[") else f"[{project}]"
    return f"- {'⚠ ' if urgent else ''}**{proj}** {text}"


def write_output(tiers: dict, projects: dict, path: Path) -> None:
    now = datetime.now().strftime("%Y-%m-%d %I:%M %p")
    total = sum(len(v) for v in tiers.values())
    n_proj = sum(1 for todos in projects.values() if todos)

    lines = [
        "# Triage Block",
        "",
        f"*Updated: {now} — run `update-triage` to refresh*",
        f"*{total} open TODOs across {n_proj} projects*",
    ]

    pending = release_pending(projects)
    if pending:
        lines.append(f"\n**RELEASE PENDING:** {' · '.join(pending)}")

    lines += ["", "---", ""]

    for tier in TIER_COLORS:
        items = tiers[tier]
        if not items:
            continue
        lines += [
            f'## <span style="color:{TIER_COLORS[tier]};font-weight:bold;">{TIER_LABELS[tier]}</span>',
            "",
            *[fmt_line(proj, raw, urgent, first_seen) for proj, raw, urgent, first_seen in items],
            "",
        ]

    orphan_list = find_orphans(projects)
    if orphan_list:
        lines += ["---", "", f"**Orphans (no session-log):** {' · '.join(orphan_list)}", ""]

    lines += [
        "---",
        "",
        '<span style="color:#555;font-size:0.85em;">'
        "~/dev/TRIAGE-BLOCK.md · auto-updated by update-triage after /handoff"
        "</span>",
        "",
    ]

    path.write_text("\n".join(lines))
    print(f"✓ TRIAGE-BLOCK.md — {total} TODOs across {n_proj} projects")
    if pending:
        print(f"  RELEASE PENDING: {', '.join(pending)}")
    if orphan_list:
        print(f"  Orphans: {', '.join(orphan_list)}")


if __name__ == "__main__":
    if not CACHE.exists():
        print(f"Cache not found: {CACHE}", file=sys.stderr)
        print("Run /dev-brief triage to build the cache.", file=sys.stderr)
        sys.exit(1)

    projects = parse_cache(CACHE)
    if not projects:
        print(f"Cache empty: {CACHE}", file=sys.stderr)
        sys.exit(1)

    item_dates = update_item_dates(projects)
    tiers = build_triage(projects, item_dates)
    write_output(tiers, projects, OUTPUT)
