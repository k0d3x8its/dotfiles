# Claude credentials — NEVER commit
claude/.claude/.credentials.json

# Claude runtime state
claude/.claude/history.jsonl
claude/.claude/sessions/
claude/.claude/projects/
claude/.claude/cache/
claude/.claude/backups/
claude/.claude/downloads/
claude/.claude/paste-cache/
claude/.claude/shell-snapshots/
claude/.claude/session-env/
claude/.claude/file-history/
claude/.claude/mcp-needs-auth-cache.json
claude/.claude/stats-cache.json
claude/.claude/settings.json.bak
claude/.claude/config/
claude/.claude/plugins/cache/
claude/.claude/plugins/marketplaces/
claude/.claude/plugins/plugin-catalog-cache.json

# Particle credentials — NEVER commit
# ~/.particle/particle.config.json contains access_token — login creates it automatically

# Claude session artifacts — generated, not config
session-log.md
RELEASE-NOTES.md
# .memory/ARCHIVE-LOG.md stays machine-local (large, low sync value); backed up out-of-repo
/.memory/ARCHIVE-LOG.md

# Episodic memory — high-churn runtime artifacts (NOT encrypted: git-crypt has no
# delta-compression, so an append-only file would bloat the repo). Durable facts
# graduate to KNOWLEDGE.md via /consolidate instead.
/.memory/EPISODIC-INDEX.md
/.memory/EPISODIC-ARCHIVE.md
/.memory/CONSOLIDATION-INBOX.md
.episodic-baseline
.episodic.lock

# git-crypt: un-ignore this repo's planning files so they encrypt + commit
# (override the global ~/.gitignore_global anchors; contents protected by .gitattributes)
!/TODOS.md
!/.work/FINDINGS.md
!/.work/PROGRESS.md
!/.work/PLAN.md
!/.memory/SESSION-LOG.md

# Code-mode runtime marker + method scratch — local per-project state, never committed
# (committing .code-active would turn code-mode ON for anyone who clones).
/.work/.code-active
/.work/GATES.md

# code-crit Sonnet-mega-spawn scratch output — no wildcard git-crypt backstop in this repo,
# so a plain ignore line is sufficient (nothing to carve out of).
/.work/scratch/

# General
.DS_Store
*.swp
*.swo
*~

# Python test bytecode — generated by unittest runs
**/__pycache__/
*.pyc
