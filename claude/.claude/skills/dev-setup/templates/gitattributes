# git-crypt: root-anchored patterns (/ prefix = match only at repo root, not subdirs).
# WARNING: never drop the / prefix — unanchored patterns encrypt like-named files in
# every subdirectory and corrupt templates and test fixtures.
/KNOWLEDGE.md filter=git-crypt diff=git-crypt
/TODOS.md filter=git-crypt diff=git-crypt
/.memory/SESSION-LOG.md filter=git-crypt diff=git-crypt
/.work/FINDINGS.md filter=git-crypt diff=git-crypt
/.work/PROGRESS.md filter=git-crypt diff=git-crypt
/.work/PLAN.md filter=git-crypt diff=git-crypt
/.work/SEC-CONTEXT.md filter=git-crypt diff=git-crypt
/docs/threat-model.md filter=git-crypt diff=git-crypt
/docs/threat-model.dfd.mmd filter=git-crypt diff=git-crypt
