{
  "permissions": {
    "deny": [
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(**/.env*)",
      "Read(~/.config/gh/**)",
      "Read(~/.netrc)",
      "Read(~/.docker/config.json)",
      "Read(~/.gnupg/**)",
      "Read(~/.kube/**)",
      "Read(~/.config/gcloud/**)",
      "Edit(~/.ssh/**)",
      "Edit(~/.aws/**)",
      "Edit(**/.env*)",
      "Bash(curl * | bash)",
      "Bash(ssh *)",
      "Bash(scp *)",
      "Bash(nc *)"
    ],
    "defaultMode": "default"
  },
  "model": "opus",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/hooks/session_timer.py\" session_start 2>/dev/null || true"
          },
          {
            "type": "command",
            "command": "h=$(git -C \"$PWD\" rev-parse HEAD 2>/dev/null) && printf '%s' \"$h\" > \"$PWD/.episodic-baseline\" || true"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/hooks/episodic_index.py\" 2>/dev/null || true"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/hooks/session_timer.py\" stop 2>/dev/null || true"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/fable-mode-inject.sh\" 2>/dev/null || true"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/hooks/command_guard.py\""
          },
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/hooks/secret_guard.py\""
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "[ -f \"$HOME/.claude/hooks/standards_guard.py\" ] && python3 \"$HOME/.claude/hooks/standards_guard.py\" pre; [ \"$?\" = 2 ] && exit 2 || exit 0"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/hooks/bash_audit.py\" 2>/dev/null || true"
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/hooks/standards_guard.py\" post 2>/dev/null || true"
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/hooks/code_formatter.py\" 2>/dev/null || true"
          },
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/hooks/code_standard_lint.py\" 2>/dev/null || true"
          },
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/hooks/gate3_skip_detector.py\""
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/hooks/refresh_triage.py\" 2>/dev/null || true"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash \"/home/k0d3x/.claude/kos-burn-tap.sh\""
  },
  "enabledPlugins": {
    "caveman@caveman": true,
    "andrej-karpathy-skills@karpathy-skills": false,
    "planning-with-files@planning-with-files": false,
    "compound-engineering@compound-engineering-plugin": true,
    "pm-toolkit@pm-skills": false,
    "pm-product-strategy@pm-skills": false,
    "pm-product-discovery@pm-skills": false,
    "pm-go-to-market@pm-skills": false,
    "pm-execution@pm-skills": false
  },
  "extraKnownMarketplaces": {
    "caveman": {
      "source": {
        "source": "github",
        "repo": "JuliusBrussee/caveman"
      }
    },
    "karpathy-skills": {
      "source": {
        "source": "github",
        "repo": "forrestchang/andrej-karpathy-skills"
      }
    },
    "planning-with-files": {
      "source": {
        "source": "github",
        "repo": "OthmanAdi/planning-with-files"
      }
    },
    "compound-engineering-plugin": {
      "source": {
        "source": "github",
        "repo": "EveryInc/compound-engineering-plugin"
      }
    },
    "pm-skills": {
      "source": {
        "source": "github",
        "repo": "phuryn/pm-skills"
      }
    }
  },
  "effortLevel": "medium",
  "advisorModel": "opus",
  "theme": "auto",
  "agentPushNotifEnabled": true
}
